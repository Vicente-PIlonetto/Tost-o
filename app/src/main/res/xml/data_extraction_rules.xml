<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Auto Backup no Google Drive e transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="meubolso.db" />
        <include domain="database" path="meubolso.db-wal" />
        <include domain="database" path="meubolso.db-shm" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="meubolso.db" />
        <include domain="database" path="meubolso.db-wal" />
        <include domain="database" path="meubolso.db-shm" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
